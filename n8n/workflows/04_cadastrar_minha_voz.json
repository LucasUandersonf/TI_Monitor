      "typeVersion": 3.4,
      "position": [
        220,
        0
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "289d6d38-9e57-5c81-965a-52108ee14de2",
              "name": "worker_url",
              "value": "https://SEU-WORKER.up.railway.app",
              "type": "string"
            },
            {
              "id": "549b4494-0c2c-5e81-ad6b-7d422fe70350",
              "name": "drive_pasta_voz",
