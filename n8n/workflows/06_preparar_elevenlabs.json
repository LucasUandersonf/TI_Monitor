          "timeout": 120000
        }
      }
    },
    {
      "id": "5f2cde9f-5cc4-561c-bf1a-2ef2156333b0",
      "name": "Conferir voz",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const s = $json;\nconst ativa = s.voz && s.voz.ativa;\nif (ativa !== 'elevenlabs') {\n  throw new Error(`A voz ativa do worker é \"${ativa}\". No Railway (serviço fabrica-worker → Variables) confira ` +\n    `ELEVENLABS_API_KEY, ELEVENLABS_VOICE_ID e TTS_MOTOR=elevenlabs.`);\n}\nconst el = s.voz.elevenlabs || {};\nreturn [{ json: { voz: ativa, modelo: el.modelo, saldo: el.saldo, sons: s.sons_biblioteca } }];"
      }
    },
    {
      "id": "bbee5bf8-48e1-5432-9882-c98890f62e99",
      "name": "Biblioteca de sons",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.worker_url }}/sfx/biblioteca",
        "options": {
          "timeout": 1800000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ confirmar: $('Config').first().json.gerar_sons === 'sim', limite_creditos: Number($('Config').first().json.limite_creditos_sons) || 1500 }) }}"
      }
    },
    {
      "id": "990bdebf-01f4-590a-9483-7396d3ba025e",
      "name": "Resultado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const v = $('Conferir voz').first().json;\nconst r = $json;\nreturn [{ json: {\n  voz: `${v.voz} · modelo ${v.modelo}`,\n  saldo_elevenlabs: v.saldo ? v.saldo.restante : 'não consegui ler (dê à chave a permissão User: read)',\n  sons: r.previa ? `${r.previa.a_gerar} sons a gerar (${r.previa.segundos_a_gerar} s de áudio). Para gerar: gerar_sons = sim`\n                 : `${(r.gerados || []).length} sons gerados · créditos gastos: ${r.creditos_gastos ?? '?'} · saldo: ${r.saldo ?? '?'}`,\n  erros: r.erros || []\n} }];"
      }
    }
  ],
