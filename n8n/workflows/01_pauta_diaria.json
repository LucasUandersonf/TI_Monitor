    {
      "id": "cd8c8e95-4233-4a03-8ea4-45850a1b8d64",
      "name": "Coletar tendências",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.worker_url }}/pauta/tendencias",
        "options": {
          "timeout": 180000
        }
      }
    },
    {
      "id": "8da6bbd2-9061-4e63-afdd-2c2e05bd2f24",
      "name": "Claude: 3 candidatos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.worker_url }}/pauta/candidatos",
        "options": {
          "timeout": 300000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ itens: $json.itens }) }}"
      }
    },
    {
      "id": "393a9a64-8da6-4746-a878-eebe1e772e5b",
      "name": "Montar mensagem",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "jsCode": "const c = $json.candidatos;\nconst url = $execution.resumeUrl;\nconst linhas = c.map((x, i) => `<b>${i + 1}. ${x.titulo_provisorio}</b>\\n<i>${x.angulo} · ${x.origem} · retenção ${x.nota_retencao}/10</i>\\n🎣 ${x.gancho}\\n💡 ${x.ideia_universal}`);\nconst teclado = { inline_keyboard: [c.map((x, i) => ({ text: `Fazer o ${i + 1}`, url: `${url}?opcao=${i}` }))] };\nreturn [{ json: { texto: '🎬 <b>Pautas de hoje</b>\\n\\n' + linhas.join('\\n\\n'), teclado, candidatos: c } }];"
      }
    },
    {
      "id": "975e4463-748e-46ed-a312-8bc3836243d3",
      "name": "Telegram: escolher pauta",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $('Config').first().json.telegram_bot_token }}/sendMessage",
        "options": {
          "timeout": 30000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $('Config').first().json.telegram_chat_id, parse_mode: 'HTML', disable_web_page_preview: true, text: $json.texto, reply_markup: $json.teclado }) }}"
      }
    },
    {
      "id": "a9ad3d99-577f-4575-86d1-a0b47a746079",
      "name": "Esperar escolha",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "resume": "webhook",
        "httpMethod": "GET",
        "limitWaitTime": true,
        "limitType": "afterTimeInterval",
        "resumeAmount": 24,
        "resumeUnit": "hours",
        "options": {}
      },
      "webhookId": "cc7f9727-dee8-43cf-a343-c4012d2214f0"
    },
    {
      "id": "43f23f32-96e7-4d2a-b9e1-96b536430eb5",
      "name": "Pegar candidato",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        0
      ],
      "parameters": {
        "jsCode": "const i = Number($json.query?.opcao ?? 0);\nconst c = $('Montar mensagem').first().json.candidatos[i];\nreturn [{ json: { tema: c } }];"
      }
    },
    {
      "id": "ba42c78e-0dbc-4785-8cf5-f12db531a9c1",
      "name": "Claude: roteiro",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.worker_url }}/pauta/roteiro",
        "options": {
          "timeout": 900000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ tema: $json.tema }) }}"
      }
    },
    {
      "id": "6da0c820-7b92-4902-8473-ba327d9ec669",
      "name": "Salvar roteiro no Drive",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        1980,
        0
      ],
      "parameters": {
        "operation": "createFromText",
        "content": "={{ $json.roteiro_markdown }}",
        "name": "={{ $now.toFormat('yyyy-MM-dd') }} · {{ $json.titulo }}",
        "driveId": {
          "__rl": true,
          "mode": "list",
          "value": "My Drive"
        },
        "folderId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $('Config').first().json.drive_pasta_roteiros }}"
        },
        "options": {
          "convertToGoogleDocument": true
        }
      }
    },
    {
      "id": "97961f58-6156-461d-b060-6fc1c9e50bae",
      "name": "Telegram: roteiro pronto",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2200,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $('Config').first().json.telegram_bot_token }}/sendMessage",
        "options": {
          "timeout": 30000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $('Config').first().json.telegram_chat_id, parse_mode: 'HTML', disable_web_page_preview: true, text: '📝 <b>Roteiro pronto:</b> ' + $('Claude: roteiro').first().json.titulo + '\\n' + $('Claude: roteiro').first().json.palavras + ' palavras\\n\\nCole na conversa de artifacts e salve o .html em <b>02 · Artifacts</b>.\\n' + ($json.webViewLink || '') }) }}"
      }
    }
