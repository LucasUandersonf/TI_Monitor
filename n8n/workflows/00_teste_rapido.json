    {
      "id": "540e0499-9608-4211-8d0f-3ec97dd38e47",
      "name": "Pronto!",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3520,
        0
      ],
      "parameters": {
        "jsCode": "const itens = $('Um item por arquivo').all().map(i => i.json);\nconst links = $input.all().map(i => i.json.webViewLink);\nconst r = $('Pegar resultado').first().json;\nreturn [{ json: {\n  titulo: r.titulo, duracao_segundos: r.duracao, voz: r.motores?.voz, avisos: r.avisos,\n  arquivos: itens.map((a, k) => ({ tipo: a.tipo, nome: a.nome, link: links[k] }))\n} }];",
        "mode": "runOnceForAllItems"
      }
    }
