    {
      "id": "22a56a1d-14bc-4674-a2d9-5f3fc4cc246d",
      "name": "Um item por arquivo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2860,
        0
      ],
      "parameters": {
        "jsCode": "const r = $json;\nreturn r.arquivos.filter(a => a.tipo !== 'metadados').map(a => ({ json: { ...a, job_id: r.job_id, titulo_video: r.titulo } }));",
        "mode": "runOnceForAllItems"
      }
    },
    {
