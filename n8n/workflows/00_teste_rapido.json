    {
      "id": "be2b5801-ec30-4b99-a85f-10a4167183c1",
      "name": "Worker está no ar?",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "method": "GET",
