    {
      "id": "857803f2-2ed3-4b58-acdb-adbb4d4baae3",
      "name": "Procurar artifact no Drive",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        660,
        0
      ],
      "parameters": {
        "resource": "fileFolder",
        "searchMethod": "name",
        "queryString": "={{ $('Config').first().json.nome_do_artifact.replace(/\\.html$/i, '') }}",
        "returnAll": true,
        "filter": {
          "folderId": {
            "__rl": true,
            "mode": "id",
            "value": "={{ $('Config').first().json.drive_pasta_artifacts }}"
          },
          "whatToSearch": "files"
        },
        "options": {
          "fields": [
            "id",
            "name"
          ]
        }
      },
      "alwaysOutputData": true
    },
    {
      "id": "8f6829f8-2683-411a-b088-6f928c439275",
      "name": "Achou?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "jsCode": "const alvo = $('Config').first().json.nome_do_artifact.trim().toLowerCase();\nconst achados = $input.all().map(i => i.json).filter(f => f.name);\nconst f = achados.find(x => x.name.toLowerCase() === alvo) || achados.find(x => x.name.toLowerCase().endsWith('.html'));\nif (!f) throw new Error(`Não achei \"${alvo}\" na pasta 02 · Artifacts. Achei: ${achados.map(x => x.name).join(', ') || 'nada'}`);\nreturn [{ json: f }];",
        "mode": "runOnceForAllItems"
      }
    },
    {
      "id": "b58f5a8e-34f1-453f-afeb-b94562738439",
      "name": "Baixar artifact",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "operation": "download",
        "fileId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.id }}"
        },
        "options": {}
      }
    },
    {
      "id": "0b245f02-a736-432d-919e-fd2fc0b06ff3",
      "name": "Montar pedido",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "jsCode": "const buf = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst cfg = $('Config').first().json;\nreturn [{ json: {\n  nome: $('Achou?').first().json.name.replace(/\\.html$/i, ''),\n  artifact_base64: buf.toString('base64'),\n  opcoes: { shorts: cfg.gerar_shorts === 'sim', max_shorts: 3, trilha: true,\n            clima_trilha: cfg.clima_trilha || 'reflexivo', trilha_arquivo: cfg.trilha_arquivo || null }\n} }];",
        "mode": "runOnceForAllItems"
      }
    },
    {
      "id": "1b13ce02-43fb-4bf8-9019-d665a83fb4ee",
      "name": "Enviar para edição",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.worker_url }}/edicao",
        "options": {
          "timeout": 120000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}"
      }
    },
    {
      "id": "00f61f8c-ea08-43f2-9980-ad82261363ae",
      "name": "Esperar 30 s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
