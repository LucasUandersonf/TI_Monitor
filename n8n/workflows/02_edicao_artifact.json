      "name": "Resumo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3520,
        80
      ],
      "parameters": {
        "jsCode": "const itens = $('Um item por arquivo').all().map(i => i.json);\nconst links = $input.all().map(i => i.json.webViewLink);\nconst linhas = itens.map((a, k) => {\n  if (a.tipo === 'longo') return `🖥️ <a href=\"${links[k]}\">Vídeo longo 16:9</a>`;\n  if (a.tipo === 'short') return `📱 <a href=\"${links[k]}\">${a.titulo || a.nome}</a>\\n${a.legenda_post || ''}\\n${(a.hashtags || []).join(' ')}`;\n  return null;\n}).filter(Boolean);\nreturn [{ json: { texto: `✅ <b>${itens[0].titulo_video}</b> pronto\\n\\n` + linhas.join('\\n\\n') } }];",
        "mode": "runOnceForAllItems"
      }
