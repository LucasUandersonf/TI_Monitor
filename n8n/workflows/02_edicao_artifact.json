    {
      "id": "25c07863-0877-43d5-b17d-a62daa293e96",
      "name": "Preparar pedido",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const partes = [];\nfor (let i = 0; i < $input.all().length; i++) {\n  const buf = await this.helpers.getBinaryDataBuffer(i, 'data');\n  partes.push(buf.toString('base64'));\n}\nconst nome = $('Todas as partes chegaram?').first().json.base;\nreturn [{ json: {\n  nome,\n  artifacts_base64: partes,              // na ordem: parte 1, parte 2...\n  callback_url: $execution.resumeUrl,\n  opcoes: { shorts: true, max_shorts: 3, trilha: true, legenda_queimada_longo: false,\n    clima_trilha: $('Config').first().json.clima_trilha || 'reflexivo',\n    trilha_arquivo: $('Config').first().json.trilha_arquivo || null }\n} }];"
      }
    },
