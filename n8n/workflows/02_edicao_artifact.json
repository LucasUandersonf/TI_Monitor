    {
      "id": "f0055723-ad41-41c4-91cb-15aaa1b5baa9",
      "name": "Identificar partes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "jsCode": "// \"Título · parte 2 de 3.html\" -> base \"Título\", parte 2, total 3. Sem \"parte\": vídeo de um arquivo só.\nconst vistos = new Set(), out = [];\nfor (const it of $input.all()) {\n  const nome = it.json.name.replace(/\\.html$/i, '');\n  const m = nome.match(/^(.*?)\\s*[·\\-–|]?\\s*parte\\s*(\\d+)\\s*de\\s*(\\d+)\\s*$/i);\n  const base = m ? m[1].trim() : nome;\n  if (vistos.has(base)) continue;\n  vistos.add(base);\n  out.push({ json: { base, total: m ? Number(m[3]) : 1 } });\n}\nreturn out;",
        "mode": "runOnceForAllItems"
      }
    },
    {
      "id": "44343702-e6ec-4d82-91fc-b24c663023fe",
      "name": "Listar arquivos da pasta",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        880,
        0
      ],
      "parameters": {
        "resource": "fileFolder",
        "searchMethod": "name",
        "queryString": "={{ $json.base }}",
        "returnAll": true,
        "filter": {
          "folderId": {
            "__rl": true,
            "mode": "id",
            "value": "={{ $('Config').first().json.drive_pasta_artifacts }}"
          },
          "whatToSearch": "files"
        },
        "options": {
          "fields": [
            "id",
            "name"
          ]
        }
      },
      "alwaysOutputData": true
    },
    {
      "id": "fba25242-904b-4b61-9da1-8e72d431cc46",
      "name": "Todas as partes chegaram?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "jsCode": "const { base, total } = $('Identificar partes').first().json;\nconst esc = base.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\nconst re = total > 1 ? new RegExp('^' + esc + '\\\\s*[·\\\\-–|]?\\\\s*parte\\\\s*(\\\\d+)\\\\s*de\\\\s*' + total + '\\\\.html$', 'i')\n                     : new RegExp('^' + esc + '\\\\.html$', 'i');\nconst partes = $input.all().map(i => i.json).filter(f => f.name && re.test(f.name))\n  .map(f => ({ ...f, parte: total > 1 ? Number(f.name.match(re)[1]) : 1 }))\n  .sort((a, b) => a.parte - b.parte);\nconst unicas = [...new Map(partes.map(p => [p.parte, p])).values()];\nif (unicas.length < total) return [];          // ainda faltam partes: a próxima execução pega\nreturn unicas.map(p => ({ json: { id: p.id, name: p.name, parte: p.parte, base, total } }));",
        "mode": "runOnceForAllItems"
      }
    },
    {
      "id": "f75bd103-8e14-497f-b342-742f3e5685e8",
