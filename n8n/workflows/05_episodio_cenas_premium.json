      "name": "Ver andamento",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3300,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const cfg = $('Config').first().json;\nconst job_id = $('Criar episódio no worker').first().json.job_id;\nlet e = {};\ntry { e = await this.helpers.httpRequest({ method: 'GET', url: `${cfg.worker_url}/jobs/${job_id}`, json: true, timeout: 30000 }); }\ncatch (err) { e = { atual: 'sem resposta do worker', concluido: false }; }\nconst etapa = e.etapas?.[e.atual] || {};\nreturn [{ json: { job_id, atual: e.atual, concluido: !!e.concluido, erro: e.atual === 'erro' ? (etapa.erro || 'falhou') : null,\n                  progresso: etapa.total ? `${etapa.feitas}/${etapa.total}` : null } }];"
      }
