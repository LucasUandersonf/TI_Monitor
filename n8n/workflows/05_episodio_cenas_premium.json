      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const cfg = $('Config').first().json;\nconst job_id = $('Criar episódio no worker').first().json.job_id;\nconst r = await this.helpers.httpRequest({ method: 'GET', url: `${cfg.worker_url}/jobs/${job_id}/resultado`, json: true, timeout: 30000 });\nreturn r.arquivos.filter(a => a.tipo !== 'metadados').map(a => ({ json: { ...a, job_id, titulo_video: r.titulo, avisos: r.avisos || [], duracao: r.duracao } }));"
