      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// só os vídeos que as fichas usam, na ordem\nconst ep = $('Escolher episódio').first().json;\nconst job = $('Criar episódio no worker').first().json;\nconst quer = new Set(job.arquivos_esperados);\nreturn ep.videos.filter(v => quer.has(v.name)).map(v => ({ json: { id: v.id, name: v.name, job_id: job.job_id } }));"
      }
