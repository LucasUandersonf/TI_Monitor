    {
      "id": "18a983cb-69c2-53d9-b10f-4852f87193d4",
      "name": "Resumo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        5280,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const itens = $('Arquivos prontos').all().map(i => i.json);\nconst links = $('Salvar no Drive').all().map(i => i.json.webViewLink);\nconst ep = $('Escolher episódio').first().json;\nconst pasta = $('Criar pasta do episódio').first().json;\nconst min = Math.floor(itens[0].duracao / 60), seg = Math.round(itens[0].duracao % 60);\nconst linhas = [`✅ <b>${itens[0].titulo_video}</b> (${min}:${String(seg).padStart(2, '0')})`, `📁 ${ep.pasta_nome}`];\nitens.forEach((a, k) => {\n  if (a.tipo === 'longo') linhas.push(`🖥️ <a href=\"${links[k]}\">Vídeo longo 16:9</a>`);\n  else if (a.tipo === 'short') linhas.push(`📱 <a href=\"${links[k]}\">${a.titulo || a.nome}</a>${a.legenda_post ? '\\n' + a.legenda_post : ''}${a.hashtags ? '\\n' + a.hashtags.join(' ') : ''}`);\n  else if (a.tipo === 'descricao') linhas.push(`📝 <a href=\"${links[k]}\">Descrição do YouTube (capítulos + créditos)</a>`);\n  else if (a.tipo === 'legenda') linhas.push(`💬 <a href=\"${links[k]}\">Legenda .srt</a>`);\n});\nconst avisos = itens[0].avisos || [];\nif (avisos.length) linhas.push('', '⚠️ Conferir antes de publicar:', ...avisos.map(a => '• ' + a));\nreturn [{ json: { texto: linhas.join('\\n'), pasta_pronta: pasta.id, avisos, arquivos: itens.map((a, k) => ({ tipo: a.tipo, nome: a.nome, link: links[k] })) } }];"
      }
    },
