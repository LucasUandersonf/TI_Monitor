# Copie para .env e preencha. Nunca suba o .env para o git.
ANTHROPIC_API_KEY=
# console.cloud.google.com > YouTube Data API v3 (grátis)
YOUTUBE_API_KEY=
# freesound.org/apiv2/apply (grátis)
FREESOUND_API_KEY=
POSTGRES_PASSWORD=troque-esta-senha

# n8n
N8N_WEBHOOK_URL=http://localhost:5678/
# do @BotFather
TELEGRAM_BOT_TOKEN=
# chat que recebe as pautas para aprovar e os vídeos prontos
TELEGRAM_CHAT_ID=
# id da pasta do Drive "03 · Vídeos prontos"
DRIVE_PASTA_PRONTOS=
# id da pasta do Drive "01 · Roteiros"
DRIVE_PASTA_ROTEIROS=
# id da pasta do Drive "02 · Artifacts" (o n8n vigia esta)
DRIVE_PASTA_ARTIFACTS=

# edição
# auto | elevenlabs | clone | kokoro_onnx | kokoro | piper  (auto usa a sua voz clonada quando ela estiver cadastrada)
TTS_MOTOR=auto
# pm_alex | pm_santa | pf_dora
KOKORO_VOZ=pm_alex
# xfade | gltransition (precisa FFmpeg com gl-transitions)
TRANSICAO_MOTOR=xfade
# quantos Chromium renderizando ao mesmo tempo
RENDER_PARALELO=3
FPS=30
# opcional: comando que gera trilha, com {prompt} {duracao} {saida}
ACE_STEP_CMD=

# voz premium (opcional; quando existe, substitui a Kokoro)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODELO=eleven_multilingual_v2
# velocidade da Kokoro (1.0 = normal)
KOKORO_VELOCIDADE=1.0

# acabamento
# subquadros de motion blur nos quadros com movimento (1 desliga; 3 é o padrão)
MOTION_BLUR=3
# opacidade da textura de papel (0 desliga)
TEXTURA_PAPEL=0.07
# trilha pelo Openverse quando a biblioteca estiver vazia (1 liga, 0 desliga)
OPENVERSE_ATIVO=1

# imagem, só quando o artifact pede
FLUX_MODELO=black-forest-labs/FLUX.1-schnell
# comando que anima um desenho com o AnimatedDrawings: {imagem} {saida} {movimento}
ANIMATED_DRAWINGS_CMD=

# quantas edições ao mesmo tempo (as outras esperam na fila)
EDICOES_SIMULTANEAS=1

# sua voz clonada (grátis): qwen3 (mais rápido em CPU) ou chatterbox (mais expressivo, melhor com GPU)
VOZ_CLONE_MOTOR=qwen3
# núcleos de CPU para a voz clonada (vazio = todos)
VOZ_THREADS=
# conferência: abaixo desta semelhança entre o texto e o que o Whisper ouviu, a frase é gerada de novo
VOZ_SEMELHANCA_MIN=0.80
# altura do vídeo longo: 1080, 1440 ou 2160 (4K). Mais alto = render mais lento, imagem mais limpa no YouTube
RESOLUCAO=1080
# token do Hugging Face (opcional; só se um download de modelo for recusado)
HF_TOKEN=
